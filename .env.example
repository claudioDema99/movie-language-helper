# Provider-free upload and fake analysis require no environment variables.
# Live adapters remain blocked until the corresponding policy/legal gates are
# approved. Credentials alone never enable either adapter.

# Offline demo analyzer: matches a built-in lexicon, no network, no key.
MLH_LEXICON_ANALYZER_ENABLED=false

MLH_OPENAI_ENABLED=false
MLH_OPENAI_RISK_ACKNOWLEDGED=false
# MLH_OPENAI_API_KEY=
# MLH_OPENAI_MODEL=exact-reviewed-model-snapshot
MLH_OPENAI_MAX_OUTPUT_TOKENS=2000

MLH_SUBDL_ENABLED=false
MLH_SUBDL_RISK_ACKNOWLEDGED=false
# MLH_SUBDL_API_KEY=
MLH_SUBDL_BASE_URL=https://api.subdl.com

# Controlled private Compose deployment (do not use as anonymous public SaaS).
# MLH_PUBLIC_HOST=movies.example.test
# MLH_PUBLIC_ORIGIN=https://movies.example.test
# MLH_SITE_ADDRESS=https://movies.example.test
# MLH_BASIC_AUTH_USERNAME=movie-helper
# Runtime credentials are mounted from ignored deploy/secrets files; see
# docs/DEPLOYMENT.md. Inline MLH_PRIVATE_ACCESS_TOKEN is for development only.
